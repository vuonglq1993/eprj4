  "item": [
    {
      "name": "Get Exercises",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://localhost:8080/api/v1/courses/{{courseId}}/lessons/{{lessonId}}/exercises",
          "host": ["http://localhost:8080"],
          "path": [
            "api",
            "v1",
            "courses",
            "{{courseId}}",
            "lessons",
            "{{lessonId}}",
            "exercises"
          ]
        }
      }
    },
    {
      "name": "Create Exercise (MCQ)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"2+2=?\",\n  \"type\": \"MULTIPLE_CHOICE\",\n  \"questionData\": \"{\\\"question\\\":\\\"2+2=?\\\",\\\"options\\\":[\\\"3\\\",\\\"4\\\",\\\"5\\\"],\\\"correctIndex\\\":1}\",\n  \"orderIndex\": 1,\n  \"points\": 10,\n  \"timeLimitSeconds\": 30\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/courses/{{courseId}}/lessons/{{lessonId}}/exercises",
          "host": ["http://localhost:8080"],
          "path": [
            "api",
            "v1",
            "courses",
            "{{courseId}}",
            "lessons",
            "{{lessonId}}",
            "exercises"
          ]
        }
      }
    },
